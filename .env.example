# ==========================================
# 应用配置 / Application Config
# ==========================================
NODE_ENV=production
PORT=9000
LOG_LEVEL=info

# ==========================================
# 数据库配置（AzerothCore，只读连接）
# 支持连接串或分字段配置，连接串优先
# Database Config (AzerothCore, read-only)
# ==========================================
DB_URL=mysql://user:pass@host:port
DB_AUTH=acore_auth
DB_CHARACTERS=acore_characters
DB_WORLD=acore_world
DB_ACM=acm

# ==========================================
# AI 诊断（LLM 配置存 acm 库，此密钥仅用于 api_key 加解密）
# 模型出口一律通过后台 UI 配置，无环境变量兜底
# ==========================================
LLM_AES_KEY=your-llm-aes-key-change-in-production

# 飞书群机器人 webhook（Token 预算超限 / 巡检失败 / 断传告警；留空仅记日志不推送）
FEISHU_WEBHOOK_URL=
# AI Token 日预算（超限告警，仅告警不停用）
AI_DAILY_TOKEN_BUDGET=5000000
# Agent 缓存容量 / 单任务工具调用预算 / 工具默认超时
AI_AGENT_CACHE_SIZE=4
AI_TOOL_CALL_BUDGET=20
AI_TOOL_TIMEOUT_MS=5000

# 腾讯云 COS（日志归档 / AI 报告归档桶，私有读；留空时日志工具明确报错）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-guangzhou

# ==========================================
# ACM 自有库（PostgreSQL，可写）：模型配置 / 会话 / LangGraph checkpoint
# 与上方 AzerothCore MySQL（只读）隔离；本地 compose 暴露 5433
# ==========================================
ACM_PG_PASSWORD=your-acm-pg-password
ACM_DB_URL=postgres://acm:your-acm-pg-password@host:5433/acm

# ==========================================
# Redis 配置（热点数据缓存 + 会话）
# 支持连接串或分字段配置，连接串优先
# Redis Config (cache + session)
# ==========================================
REDIS_URL=redis://:password@host:port/db
REDIS_EXPIRE_TIME=300

# ==========================================
# JWT 认证配置 / JWT Auth Config
# ==========================================
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=8h

# ==========================================
# SOAP 配置（GM 命令执行）
# 格式: http://user:pass@host:port
# SOAP Config (GM command execution)
# ==========================================
SOAP_URL=http://admin:admin@127.0.0.1:7878

# ==========================================
# CORS 配置
# ==========================================
ALLOWED_ORIGINS=https://your-admin-site.com

# ==========================================
# 登录安全 / Login Security
# ==========================================
# 是否启用防暴力破解
LOGIN_BRUTE_FORCE_ENABLED=true

# 允许连续失败的最大次数，达到后锁定
LOGIN_MAX_ATTEMPTS=5

# 锁定时间（分钟）
LOGIN_LOCKOUT_MINUTES=15

# 是否启用自研图形验证码（失败 3 次后触发）
LOGIN_CAPTCHA_ENABLED=false

# 验证码有效期（秒）
LOGIN_CAPTCHA_TTL_SECONDS=300
