# ==========================================
# 应用配置 / Application Config
# ==========================================
NODE_ENV=production
PORT=9000
LOG_LEVEL=info

# ==========================================
# 数据库配置（AzerothCore，只读连接）
# 支持连接串或分字段配置，连接串优先
# Database Config (AzerothCore, read-only)
# ==========================================
DB_URL=mysql://user:pass@host:port
DB_AUTH=acore_auth
DB_CHARACTERS=acore_characters
DB_WORLD=acore_world

# ==========================================
# Redis 配置（热点数据缓存 + 会话）
# 支持连接串或分字段配置，连接串优先
# Redis Config (cache + session)
# ==========================================
REDIS_URL=redis://:password@host:port/db
REDIS_EXPIRE_TIME=300

# ==========================================
# JWT 认证配置 / JWT Auth Config
# ==========================================
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=8h

# ==========================================
# SOAP 配置（GM 命令执行）
# SOAP Config (GM command execution)
# ==========================================
SOAP_HOST=127.0.0.1
SOAP_PORT=7878
SOAP_USER=admin
SOAP_PASS=admin

# ==========================================
# CORS 配置
# ==========================================
ALLOWED_ORIGINS=https://your-admin-site.com

# ==========================================
# 外部链接 / External Links
# ==========================================
ARMORY_BASE_URL=
SERVER_NAME=

# ==========================================
# 外部资源地址 / External Asset URLs
# 图标 CDN 地址，生产环境建议替换为自托管 CDN（如腾讯云 COS）
# 国内访问 Wowhead CDN 可能不稳定
# ==========================================
VITE_ICON_BASE_URL=https://wow.zamimg.com/images/wow/icons/medium
VITE_AOWOW_BASE_URL=https://wowgaming.altervista.org/aowow
