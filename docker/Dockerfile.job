# SCF Job 函数专用镜像（与 web 单体镜像分开构建部署）：
# 不含前端静态资源与字体依赖，入口按事件 task 路由到一次性任务，跑完进程退出。
# Stage 1: Backend build
# 构建层钉在构建机原生架构（产物为架构无关 JS）
FROM --platform=$BUILDPLATFORM node:22-alpine AS backend-builder
WORKDIR /app/backend
COPY backend/package*.json ./
RUN npm ci --legacy-peer-deps
COPY backend/ ./
RUN npm run build

# Stage 2: Job runtime
FROM node:22-alpine AS job-runtime
WORKDIR /app
# ripgrep：agent grep 工具走原生 rg（JS 回退只作兜底）；NODE_OPTIONS：1GB 容器默认堆 ~512MB，
# 2026-10-22 OOM 事故后显式抬高留堆外余量（日志访问已流式化，此为纵深防御）
RUN apk add --no-cache ripgrep
ENV NODE_OPTIONS=--max-old-space-size=768
COPY backend/package*.json ./
RUN npm ci --legacy-peer-deps --omit=dev && npm cache clean --force
COPY --from=backend-builder /app/backend/dist ./dist
RUN addgroup -g 1001 -S nodejs && adduser -S nodejs -u 1001
USER nodejs
# ENTRYPOINT 固定入口：事件经环境变量注入（JSON 契约 {"task":"inspection","params":{...}}），
# 本地调试：docker run -e SCF_CUSTOM_CONTAINER_EVENT='<json>' <image>
ENTRYPOINT ["node", "dist/job/job-entry.js"]
