# 本地 Docker 全链路验证的环境覆盖（cp 为 .env.e2e 后按需修改；已 gitignore）
# 只需覆盖「容器内可达性」：把 .env 里各连接串的 host 换成 host.docker.internal，端口/库名/凭证照抄 .env。
# SCF 触发相关（SCF_ENDPOINT/TENCENT_* 等）由 docker-compose.e2e.yml 注入，不在此维护。

DB_URL=mysql://user:pass@host.docker.internal:3306
ACM_DB_URL=postgres://acm:your-acm-pg-password@host.docker.internal:5433/acm
REDIS_URL=redis://:password@host.docker.internal:6379
